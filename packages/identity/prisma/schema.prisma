datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum Status {
  ACTIVE
  INACTIVE
}

model Tenant {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  businessName String
  businessType String?
  plan         String?  @default("FREE")
  logoUrl      String?
  logoKey      String?
  phone        String?
  email        String?
  address      String?
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
}

model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  email       String   @unique
  name        String   
  password    String
  role String? @default("RECEPTION")
  status      Status   @default(ACTIVE)
  
  attendsPatients Boolean  @default(false)
  specialties     String[] @default([])
  professionalTitle String?
  licenseNumber     String?
  avatarUrl     String?
  signatureUrl  String?
  phoneNumber   String?

  tenantId    Int
  tenantUUID  String?   
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserAudit {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  tenantUUID String
  actorUuid  String
  actorName  String
  targetUuid String
  targetName String
  field      String
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([tenantUUID, createdAt])
  @@index([targetUuid])
}
