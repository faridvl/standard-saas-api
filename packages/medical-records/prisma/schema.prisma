datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// Estado de un mantenimiento del paciente: lo marca el personal a mano.
enum MaintenanceStatus {
  UNMARKED
  ATTENDED
  MISSED
}

enum DocumentCategory {
  EVOLUTION_CONTROL
  WARRANTY
  EXTERNAL_TEST
  CLINICAL_HISTORY
  OTHER
}

// Copia local minima de usuarios de identity, resuelta de forma perezosa
// (get-or-create) para poder mostrar el nombre de quien creo un registro
// sin depender de un JOIN cross-servicio. Puede quedar desactualizada si
// el usuario cambia de nombre en identity; se resincroniza en el proximo
// get-or-create donde el uuid ya conocido no requiere refresco.
model User {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  tenantUuid String
  fullName   String
  updatedAt  DateTime @updatedAt

  @@index([tenantUuid])
}

/// Enlace de calendario suscrito (webcal) de un usuario: su app de
/// calendario (iPhone, Outlook, Google) lee las citas con este token, porque
/// no puede iniciar sesión. Uno por usuario; regenerarlo invalida el anterior
/// y borrarlo lo desconecta.
model CalendarFeed {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  token      String   @unique
  tenantUuid String
  userUuid   String   @unique
  /// Calendarios ("sede" o "sede:tipo") quitados desde el back-office: se publican vacíos.
  removedCalendarKeys String[] @default([])
  /// Última vez que el teléfono pidió cada calendario: { "sede[:tipo]": ISO }.
  fetchedCalendars    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantUuid])
}

model Branch {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  tenantUuid String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  patients     Patient[]
  patientBranches PatientBranch[]
  appointments Appointment[]

  @@index([tenantUuid])
}

// Sedes de un paciente. Patient.branchUuid es la principal y siempre está aquí.
model PatientBranch {
  id          Int      @id @default(autoincrement())
  patientUuid String
  branchUuid  String
  tenantUuid  String
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientUuid], references: [uuid])
  branch  Branch  @relation(fields: [branchUuid], references: [uuid])

  @@unique([patientUuid, branchUuid])
  @@index([branchUuid])
  @@index([tenantUuid])
}

model Patient {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  address      String?
  // Indicadores que se prenden y apagan: desde cuándo están prendidos, null si no.
  hearingAidsInLabSince DateTime?
  warrantyActiveSince   DateTime?
  videoCandidateSince   DateTime?
  warrantyExpiredSince  DateTime?
  renewPrescriptionSince DateTime?
  // Marca de prioridad: solo marca y filtro, no cambia el orden de la lista.
  prioritySince          DateTime?
  // Mantenimientos 1 a 4: estado marcado a mano por el personal. Sus notas viven en
  // PatientMaintenanceNote.
  maintenance1Status MaintenanceStatus @default(UNMARKED)
  maintenance2Status MaintenanceStatus @default(UNMARKED)
  maintenance3Status MaintenanceStatus @default(UNMARKED)
  maintenance4Status MaintenanceStatus @default(UNMARKED)
  // Sin uso desde D40 (reemplazadas por el estado y las notas); pendientes de borrar.
  maintenance1Done   Boolean   @default(false)
  maintenance1Note   String?
  maintenance2Done   Boolean   @default(false)
  maintenance2Note   String?
  maintenance3Done   Boolean   @default(false)
  maintenance3Note   String?
  maintenance4Done   Boolean   @default(false)
  maintenance4Note   String?
  // Documento del expediente (PatientDocument) elegido como garantía. Sin FK:
  // al borrar el documento el caso de uso lo deja en null.
  warrantyDocumentUuid  String?
  // Opcional: el pre-registro rápido de la agenda no lo pide; se completa en el expediente.
  birthDate    DateTime?
  email        String?
  gender              String?
  bloodType           String?
  linkedProductUuid   String?
  documentId          String?
  occupation          String?
  branchUuid          String?

  // Mes tentativo de la próxima cita (formato "YYYY-MM"), anterior a que el
  // paciente confirme el día. La recepción lo anota al llamar; cuando el
  // paciente confirma se agenda la cita real y este campo se limpia. No es
  // una cita: no vive en Appointment porque ahí `date` exige un día concreto
  // y un día inventado se leería como fecha acordada.
  tentativeAppointmentMonth String?
  // De qué sería esa próxima cita (AppointmentType). Se anota junto al mes y
  // se precarga al confirmar el día, donde todavía puede cambiarse. Sin FK
  // porque es una intención, no una cita: si la clínica borra un tipo, el
  // apunte no debe impedirlo ni arrastrar al paciente.
  tentativeAppointmentTypeUuid String?

  // Estado del paciente para la clínica (PatientStatus en domain/types):
  // ACTIVE, INACTIVE (dejó de venir) o DECEASED. Es independiente del
  // borrado lógico (`isActive`/`deletedAt`), que sigue significando "registro
  // eliminado". `statusReason` es el motivo libre al pasar a inactivo y
  // `statusDate` la fecha de fallecimiento, si se conoce.
  status          String    @default("ACTIVE")
  statusReason    String?
  statusDate      DateTime?
  statusChangedAt DateTime?

  tenantId     Int
  tenantUuid   String
  createdBy    String

  isActive     Boolean  @default(true)
  deletedAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments    Appointment[]
  medicalControls MedicalControl[]
  background      PatientBackground?
  physicalExam    PatientPhysicalExam?
  maintenances    Maintenance[]
  devices         PatientDevice[]
  documents       PatientDocument[]
  encounters      Encounter[]
  studies         Study[]
  contacts        PatientContact[]
  notes           PatientNote[]
  maintenanceNotes PatientMaintenanceNote[]
  questionnaireEntries PatientQuestionnaireEntry[]
  otoscopyEntries PatientOtoscopyEntry[]
  audiometryEntries PatientAudiometryEntry[]
  labShipments    PatientLabShipment[]
  branch          Branch?  @relation(fields: [branchUuid], references: [uuid])
  branches        PatientBranch[]

  @@index([tenantId])
  @@index([isActive])
  @@index([tenantUuid, documentId])
  @@index([branchUuid])
  @@index([tenantUuid, status])
}

model PatientBackground {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  patientUuid   String   @unique
  earInfections Boolean  @default(false)
  nasalSurgery  Boolean  @default(false)
  throatSurgery Boolean  @default(false)
  earSurgery    Boolean  @default(false)
  diabetes      Boolean  @default(false)
  cholesterol   Boolean  @default(false)
  highPressure  Boolean  @default(false)
  allergies     Boolean  @default(false)
  rhinitis      Boolean  @default(false)
  vertigo       Boolean  @default(false)
  tinnitus      Boolean  @default(false)
  headacheNoise Boolean  @default(false)
  cloggedEar    Boolean  @default(false)
  dizziness     Boolean  @default(false)
  tinnitusTone  String?
  otoscopyRight String?
  otoscopyLeft  String?
  notes         String?
  /// Respuestas por id de pregunta, con las preguntas tal como estaban al llenarla.
  answers          Json?
  templateSnapshot Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdByUuid String?
  updatedByUuid String?

  patient       Patient  @relation(fields: [patientUuid], references: [uuid])
}

/// Exploración física (otoscopia): una por paciente, aparte de la historia clínica.
model PatientPhysicalExam {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  patientUuid   String   @unique
  otoscopyRight String?
  otoscopyLeft  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdByUuid String?
  updatedByUuid String?

  patient       Patient  @relation(fields: [patientUuid], references: [uuid])
}

/// Una vez que se llenó una sección propia de la clínica (ClinicalTemplate QUESTIONNAIRE).
/// Append-only: cada vez deja un registro; `templateSnapshot` guarda el nombre y las
/// preguntas tal como estaban, para que editar la sección no cambie lo ya llenado.
model PatientQuestionnaireEntry {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  patientUuid      String
  templateUuid     String
  templateSnapshot Json
  answers          Json
  createdAt        DateTime @default(now())
  createdByUuid    String
  // Solo se llenan al corregir el registro (el mismo día en que se creó).
  updatedAt        DateTime?
  updatedByUuid    String?

  patient          Patient  @relation(fields: [patientUuid], references: [uuid])
  revisions        PatientQuestionnaireEntryRevision[]

  @@index([patientUuid, createdAt])
  @@index([templateUuid])
}

// Las respuestas que tenía un registro justo antes de cada corrección: nada se borra.
model PatientQuestionnaireEntryRevision {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  entryUuid     String
  tenantUuid    String
  answers       Json
  revisedAt     DateTime
  // Quien hizo la corrección que reemplazó estas respuestas.
  revisedByUuid String

  entry         PatientQuestionnaireEntry @relation(fields: [entryUuid], references: [uuid])

  @@index([entryUuid, revisedAt])
  @@index([tenantUuid])
}

/// Historial de envíos de audífonos al laboratorio: cada envío tiene su día de salida y, al
/// entregarse, su día de regreso. Máximo uno abierto (deliveredAt nulo) por paciente: el índice
/// parcial único "PatientLabShipment_one_open_per_patient" lo garantiza y vive solo en la migración.
/// Si una migración generada lo borra, editarla para conservarlo (20261102180000_patient_lab_shipments).
model PatientLabShipment {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  tenantUuid      String
  patientUuid     String
  // Días guardados a mediodía UTC, igual que Patient.hearingAidsInLabSince.
  sentAt          DateTime
  deliveredAt     DateTime?
  note            String?
  // Nulo en los envíos abiertos por la migración desde datos viejos.
  createdByUuid   String?
  deliveredByUuid String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient         Patient   @relation(fields: [patientUuid], references: [uuid])

  @@index([tenantUuid, patientUuid, sentAt])
}

/// Historial de otoscopia (exploración física): cada vez que se evalúa queda un registro.
/// Reemplaza a PatientPhysicalExam, que se conserva mientras el front viejo la lea.
model PatientOtoscopyEntry {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  tenantUuid    String
  patientUuid   String
  otoscopyRight String?
  otoscopyLeft  String?
  createdAt     DateTime  @default(now())
  // Nulo en los registros copiados de la otoscopia única cuando no se sabía quién la guardó.
  createdByUuid String?
  // Solo se llenan al corregir el registro (el mismo día en que se creó).
  updatedAt     DateTime?
  updatedByUuid String?

  patient       Patient   @relation(fields: [patientUuid], references: [uuid])
  revisions     PatientOtoscopyEntryRevision[]

  @@index([tenantUuid, patientUuid, createdAt])
}

/// Historial de audiometrías de un paciente: un registro inmutable por cada guardado.
model PatientAudiometryEntry {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  tenantUuid    String
  patientUuid   String
  // Version del contrato del payload; permite leer registros viejos si el contrato cambia.
  schemaVersion Int
  payload       Json
  createdAt     DateTime @default(now())
  createdByUuid String
  // Marca definitiva de "mal hecha": el payload no cambia. Los tres campos van juntos o todos nulos.
  invalidatedAt      DateTime?
  invalidatedByUuid  String?
  invalidationReason String?

  patient       Patient  @relation(fields: [patientUuid], references: [uuid])

  @@index([tenantUuid, patientUuid, createdAt])
}

/// El texto que tenía un registro de otoscopia justo antes de cada corrección: nada se borra.
model PatientOtoscopyEntryRevision {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  entryUuid     String
  tenantUuid    String
  otoscopyRight String?
  otoscopyLeft  String?
  revisedAt     DateTime
  // Quien hizo la corrección que reemplazó este texto.
  revisedByUuid String

  entry         PatientOtoscopyEntry @relation(fields: [entryUuid], references: [uuid])

  @@index([entryUuid, revisedAt])
  @@index([tenantUuid])
}

model PatientContact {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  patientUuid String
  tenantUuid  String
  name        String
  phone       String
  createdAt   DateTime @default(now())

  patient     Patient  @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
}

// Bitacora libre del paciente: que hizo el medico en una consulta, sin
// necesidad de una cita/encounter formal asociada. Append-only (NOM-004
// 5.10/5.11: toda nota lleva autor, no se edita ni se borra -- para
// corregir algo se agrega una nota nueva).
model PatientNote {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(uuid())
  patientUuid String
  tenantUuid  String
  authorUuid  String
  category    DocumentCategory @default(EVOLUTION_CONTROL)
  text        String           @db.VarChar(2500)
  createdAt   DateTime         @default(now())

  patient     Patient          @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
}

// Historial de notas de los mantenimientos 1 a 4 de un paciente. Append-only: las notas
// no se editan ni se borran. `createdByUuid` es null en las migradas sin autor conocido.
model PatientMaintenanceNote {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  tenantUuid    String
  patientUuid   String
  number        Int
  text          String   @db.VarChar(500)
  createdAt     DateTime @default(now())
  createdByUuid String?

  patient       Patient  @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid, number, createdAt])
  @@index([tenantUuid])
}

// Bitácora de lo que el personal hace con cada paciente (alta, cambios de
// datos, notas, archivos, citas). Append-only: nunca se edita ni se borra.
// `patientName` es una copia al momento de la acción para que el registro
// siga leyéndose igual si después se corrige el nombre. Sin FK a Patient a
// propósito: la bitácora no debe impedir ni arrastrar cambios del paciente.
// `action` es un PatientActivityAction (domain/types) y `detail` su payload.
model PatientActivity {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  tenantUuid  String
  patientUuid String
  patientName String
  actorUuid   String
  action      String
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([tenantUuid, createdAt])
  @@index([patientUuid])
  @@index([actorUuid])
  @@index([tenantUuid, patientUuid, createdAt])
}

model PatientDevice {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(uuid())
  patientUuid     String
  tenantUuid      String
  side            String       // 'OD' | 'OI' | 'AMBOS'
  isActive        Boolean      @default(true)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  productUnit     ProductUnit? @relation(fields: [productUnitId], references: [id])
  productUnitId   Int?         @map("product_unit_id")

  patient         Patient      @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
  @@index([productUnitId])
}

model PatientDocument {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  patientUuid    String
  tenantUuid     String
  originalName   String
  url            String
  category       DocumentCategory @default(OTHER)
  size           Int      @default(0)
  uploadedAt     DateTime @default(now())
  uploadedByUuid String   @default("")

  patient        Patient  @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
}

model Maintenance {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  patientUuid       String
  tenantUuid        String
  performedBy       String
  performedAt       DateTime  @default(now())
  description       String    @db.Text
  nextMaintenanceAt DateTime?
  deviceUuid        String?
  encounterUuid     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient           Patient   @relation(fields: [patientUuid], references: [uuid])
  encounter         Encounter? @relation(fields: [encounterUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
  @@index([nextMaintenanceAt])
  @@index([encounterUuid])
}

model MedicalControl {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  patientUUID     String
  userUUID        String
  tenantUUID      String
  appointmentUUID String?  @unique
  encounterUuid   String?
  speciality      String
  findings          Json
  diagnosis         String   @db.Text
  followUp          Json?
  correctionNotes   String?  @db.Text
  templateSnapshot  Json?
  schemaVersion   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  patient         Patient      @relation(fields: [patientUUID], references: [uuid])
  appointment     Appointment? @relation(fields: [appointmentUUID], references: [uuid])
  encounter       Encounter?   @relation(fields: [encounterUuid], references: [uuid])

  @@index([patientUUID])
  @@index([tenantUUID])
  @@index([encounterUuid])
}

// Encuentro = la visita como unidad persistente (reemplaza consulta-session.ts
// en sessionStorage). Cita != Encuentro: la cita es una intención, el encuentro
// es la atención que ocurrió. appointmentUuid es NULLABLE porque hay encuentros
// sin cita (walk-in) y citas sin encuentro (no asistió).
model Encounter {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  patientUuid     String
  tenantUuid      String
  autorUuid       String // NOM-004 5.10: toda nota lleva autor
  especialidad    String
  appointmentUuid String?   @unique
  startedAt       DateTime  @default(now())
  closedAt        DateTime?
  status          String    @default("OPEN") // OPEN | CLOSED

  patient         Patient          @relation(fields: [patientUuid], references: [uuid])
  appointment     Appointment?     @relation(fields: [appointmentUuid], references: [uuid])
  medicalControls MedicalControl[]
  maintenances    Maintenance[]
  studies         Study[]

  @@index([patientUuid])
  @@index([tenantUuid])
}

// Estudio = una medición estructurada (audiometría, test psicométrico...).
// No es una nota de evolución: es repetible y se compara en el tiempo
// (DOMAIN_ANALYSIS.md §1, §2.2). Inmutable — repetir la medición crea un
// Study nuevo, nunca se sobrescribe el existente (append-only, NOM-004 5.11).
model Study {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  encounterUuid String
  patientUuid   String
  tenantUuid    String
  autorUuid     String
  tipo          String   // AUDIOMETRIA_TONAL | TEST_PSICOMETRICO
  payload       Json
  documentUuid  String?
  createdAt     DateTime @default(now())

  encounter     Encounter @relation(fields: [encounterUuid], references: [uuid])
  patient       Patient   @relation(fields: [patientUuid], references: [uuid])

  @@index([encounterUuid])
  @@index([patientUuid])
  @@index([tenantUuid])
}

model AppointmentType {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String
  duration    Int?
  color       String?
  speciality  String?
  /// El tipo que cuenta como "control" (tarjeta "Controles este mes"). Uno por tenant como máximo.
  isControl   Boolean  @default(false)
  tenantUUID  String

  appointments Appointment[]

  @@index([tenantUUID])
}

model Appointment {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  patientUUID       String
  userUUID          String          
  tenantUUID        String
  typeUUID          String
  branchUUID        String?
  speciality        String
  status            String
  date              DateTime
  startTime         DateTime
  endTime           DateTime
  notes             String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relaciones
  patient           Patient         @relation(fields: [patientUUID], references: [uuid])
  appointmentType   AppointmentType @relation(fields: [typeUUID], references: [uuid])
  branch            Branch?         @relation(fields: [branchUUID], references: [uuid])
  medicalControl    MedicalControl?
  encounter         Encounter?

  @@index([patientUUID])
  @@index([tenantUUID])
  @@index([userUUID])
  @@index([branchUUID])
}

model ClinicalTemplate {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  tenantUuid  String
  name        String
  speciality  String
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Texto markdown con variables {{clave}}. El índice único (tenantUuid, lower(name)) vive solo en la migración.
model DocumentTemplate {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  tenantUuid    String
  name          String
  description   String?
  content       String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdByUuid String
  updatedByUuid String
}

model Product {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  tenantUuid   String

  sku          String   @unique
  name         String
  brand        String?
  model        String?
  description  String?

  price        Decimal  @default(0.00) @db.Decimal(15, 2)
  minStock     Int      @default(5) @map("min_stock")
  cabysCode    String?  @map("cabys_code")

  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  speciality   String?

  units        ProductUnit[]

  @@index([tenantUuid])
  @@index([sku])
}

model ProductUnit {
  id                    Int       @id @default(autoincrement())
  uuid                  String    @unique @default(uuid())
  serialNumber          String    @unique
  status                String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | DAMAGED | RETIRED
  purchaseDate          DateTime?
  warrantyUntil         DateTime?
  photoUrl              String?
  notes                 String?   @db.Text
  assignedToPatientUuid String?
  assignedAt            DateTime?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  product               Product   @relation(fields: [productId], references: [id])
  productId             Int       @map("product_id")

  patientDevices        PatientDevice[]

  @@index([productId])
  @@index([status])
  @@index([serialNumber])
}