datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

enum DocumentCategory {
  EVOLUTION_CONTROL
  WARRANTY
  EXTERNAL_TEST
  CLINICAL_HISTORY
  OTHER
}

model Patient {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  address      String?
  birthDate    DateTime
  email        String?
  gender              String?
  bloodType           String?
  linkedProductUuid   String?
  documentId          String?
  occupation          String?
  sede                String?

  tenantId     Int
  tenantUuid   String
  createdBy    String

  isActive     Boolean  @default(true)
  deletedAt    DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments    Appointment[]
  medicalControls MedicalControl[]
  background      PatientBackground?
  maintenances    Maintenance[]
  devices         PatientDevice[]
  documents       PatientDocument[]
  encounters      Encounter[]
  studies         Study[]

  @@index([tenantId])
  @@index([isActive])
  @@index([tenantUuid, documentId])
}

model PatientBackground {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  patientUuid   String   @unique
  earInfections Boolean  @default(false)
  nasalSurgery  Boolean  @default(false)
  throatSurgery Boolean  @default(false)
  earSurgery    Boolean  @default(false)
  diabetes      Boolean  @default(false)
  cholesterol   Boolean  @default(false)
  highPressure  Boolean  @default(false)
  allergies     Boolean  @default(false)
  rhinitis      Boolean  @default(false)
  vertigo       Boolean  @default(false)
  tinnitus      Boolean  @default(false)
  headacheNoise Boolean  @default(false)
  cloggedEar    Boolean  @default(false)
  notes         String?
  updatedAt     DateTime @updatedAt

  patient       Patient  @relation(fields: [patientUuid], references: [uuid])
}

model PatientDevice {
  id              Int          @id @default(autoincrement())
  uuid            String       @unique @default(uuid())
  patientUuid     String
  tenantUuid      String
  side            String       // 'OD' | 'OI' | 'AMBOS'
  isActive        Boolean      @default(true)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  productUnit     ProductUnit? @relation(fields: [productUnitId], references: [id])
  productUnitId   Int?         @map("product_unit_id")

  patient         Patient      @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
  @@index([productUnitId])
}

model PatientDocument {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  patientUuid  String
  tenantUuid   String
  originalName String
  url          String
  category     DocumentCategory @default(OTHER)
  size         Int      @default(0)
  uploadedAt   DateTime @default(now())

  patient      Patient  @relation(fields: [patientUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
}

model Maintenance {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(uuid())
  patientUuid       String
  tenantUuid        String
  performedBy       String
  performedAt       DateTime  @default(now())
  description       String    @db.Text
  nextMaintenanceAt DateTime?
  deviceUuid        String?
  encounterUuid     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient           Patient   @relation(fields: [patientUuid], references: [uuid])
  encounter         Encounter? @relation(fields: [encounterUuid], references: [uuid])

  @@index([patientUuid])
  @@index([tenantUuid])
  @@index([nextMaintenanceAt])
  @@index([encounterUuid])
}

model MedicalControl {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  patientUUID     String
  userUUID        String
  tenantUUID      String
  appointmentUUID String?  @unique
  encounterUuid   String?
  speciality      String
  findings          Json
  diagnosis         String   @db.Text
  followUp          Json?
  correctionNotes   String?  @db.Text
  templateSnapshot  Json?
  schemaVersion   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relaciones
  patient         Patient      @relation(fields: [patientUUID], references: [uuid])
  appointment     Appointment? @relation(fields: [appointmentUUID], references: [uuid])
  encounter       Encounter?   @relation(fields: [encounterUuid], references: [uuid])

  @@index([patientUUID])
  @@index([tenantUUID])
  @@index([encounterUuid])
}

// Encuentro = la visita como unidad persistente (reemplaza consulta-session.ts
// en sessionStorage). Cita != Encuentro: la cita es una intención, el encuentro
// es la atención que ocurrió. appointmentUuid es NULLABLE porque hay encuentros
// sin cita (walk-in) y citas sin encuentro (no asistió).
model Encounter {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid())
  patientUuid     String
  tenantUuid      String
  autorUuid       String // NOM-004 5.10: toda nota lleva autor
  especialidad    String
  appointmentUuid String?   @unique
  startedAt       DateTime  @default(now())
  closedAt        DateTime?
  status          String    @default("OPEN") // OPEN | CLOSED

  patient         Patient          @relation(fields: [patientUuid], references: [uuid])
  appointment     Appointment?     @relation(fields: [appointmentUuid], references: [uuid])
  medicalControls MedicalControl[]
  maintenances    Maintenance[]
  studies         Study[]

  @@index([patientUuid])
  @@index([tenantUuid])
}

// Estudio = una medición estructurada (audiometría, test psicométrico...).
// No es una nota de evolución: es repetible y se compara en el tiempo
// (DOMAIN_ANALYSIS.md §1, §2.2). Inmutable — repetir la medición crea un
// Study nuevo, nunca se sobrescribe el existente (append-only, NOM-004 5.11).
model Study {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  encounterUuid String
  patientUuid   String
  tenantUuid    String
  autorUuid     String
  tipo          String   // AUDIOMETRIA_TONAL | TEST_PSICOMETRICO
  payload       Json
  documentUuid  String?
  createdAt     DateTime @default(now())

  encounter     Encounter @relation(fields: [encounterUuid], references: [uuid])
  patient       Patient   @relation(fields: [patientUuid], references: [uuid])

  @@index([encounterUuid])
  @@index([patientUuid])
  @@index([tenantUuid])
}

model AppointmentType {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String
  duration    Int?
  color       String?
  speciality  String?
  tenantUUID  String

  appointments Appointment[]

  @@index([tenantUUID])
}

model Appointment {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  patientUUID       String
  userUUID          String          
  tenantUUID        String
  typeUUID          String
  speciality        String
  status            String          
  date              DateTime        
  startTime         DateTime        
  endTime           DateTime        
  notes             String?         
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relaciones
  patient           Patient         @relation(fields: [patientUUID], references: [uuid])
  appointmentType   AppointmentType @relation(fields: [typeUUID], references: [uuid])
  medicalControl    MedicalControl?
  encounter         Encounter?

  @@index([patientUUID])
  @@index([tenantUUID])
  @@index([userUUID])
}

model ClinicalTemplate {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  tenantUuid  String
  name        String
  speciality  String
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  tenantUuid   String

  sku          String   @unique
  name         String
  brand        String?
  model        String?
  description  String?

  price        Decimal  @default(0.00) @db.Decimal(15, 2)
  minStock     Int      @default(5) @map("min_stock")
  cabysCode    String?  @map("cabys_code")

  isActive     Boolean  @default(true) @map("is_active")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  speciality   String?

  units        ProductUnit[]

  @@index([tenantUuid])
  @@index([sku])
}

model ProductUnit {
  id                    Int       @id @default(autoincrement())
  uuid                  String    @unique @default(uuid())
  serialNumber          String    @unique
  status                String    @default("AVAILABLE") // AVAILABLE | ASSIGNED | DAMAGED | RETIRED
  purchaseDate          DateTime?
  warrantyUntil         DateTime?
  photoUrl              String?
  notes                 String?   @db.Text
  assignedToPatientUuid String?
  assignedAt            DateTime?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  product               Product   @relation(fields: [productId], references: [id])
  productId             Int       @map("product_id")

  patientDevices        PatientDevice[]

  @@index([productId])
  @@index([status])
  @@index([serialNumber])
}