meta {
  name: Set User Status
  type: http
  seq: 4
}

patch {
  url: {{identityUrl}}/users/:uuid/status
  body: json
  auth: bearer
}

params:path {
  uuid: 
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "INACTIVE"
  }
}

docs {
  Solo OWNER. status: ACTIVE | INACTIVE. 409 si es el último OWNER activo.
}
