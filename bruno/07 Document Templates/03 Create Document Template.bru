  {
    "name": "Consentimiento audiometría",
    "description": "Antes de realizar la audiometría",
    "content": "Yo {{nombre_completo}}, documento {{documento}}, autorizo el examen el {{fecha_hoy}}. Atendido por {{profesional}}."
  }
}
